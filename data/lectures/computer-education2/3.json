,"links":[],"sourcePage":5,"videoFrames":[],"lines":[[0.0661,0.0751,0.2382,0.1067,"데이터의 개념"],[0.1196,0.2884,0.1859,0.0474,"데이터, 정보, 지식, 지혜"],[0.9638,0.9294,0.0082,0.0237,"5"]],"pictures":[{"src":"/images/lectures/computer-education2/3/pictures/3d3db4b4a1ae0880.webp","x":0.2466,"y":0.3741,"width":0.5068,"height":0.5093}]},{"title":"데이터와 빅데이터","text":["데이터와 빅데이터","6","정보량의 증가"],"image":"/images/lectures/computer-education2/3/006.webp","videos":[],"links":[],"sourcePage":6,"videoFrames":[],"lines":[[0.0661,0.0751,0.3146,0.1067,"데이터와 빅데이터"],[0.1196,0.2884,0.1099,0.0474,"정보량의 증가"],[0.9638,0.9294,0.0082,0.0237,"6"]],"pictures":[{"src":"/images/lectures/computer-education2/3/pictures/ba030e46bfb01f14.webp","x":0.2745,"y":0.2893,"width":0.4509,"height":0.6639}]},{"title":"데이터의 유형","text":["데이터의 유형","7","Ⅷ-1. 데이터 이해","정형 데이터","숫자로 명확하게 정의되고 구조화된 데이터","짧은 텍스트, 날짜까지는 포함하기도 함","쉽게 저장하고 관리할 수 있는 데이터로 분석 및 처리가 쉬움","객관적인 측정 및 다양한 분석 도구를 활용해 분석이 가능","비정형 데이터","텍스트, 이미지, 오디오, 비디오 등 숫자나 문자로 쉽게 표현하기 어려운 데이터","분석이나 처리가 정형 데이터에 비해 어려움","반정형 데이터","정형 데이터와 비정형 데이터의 중간적인 특성을 가진 데이터","일부 구조를 가지고 있지만, 완전히 정형화되지 않은 형태","XML, JSON 등의 형식으로 저장"],"image":"/images/lectures/computer-education2/3/007.webp","videos":[],"links":[],"sourcePage":7,"videoFrames":[],"lines":[[0.0661,0.0751,0.2382,0.1067,"데이터의 유형"],[0.1196,0.2884,0.093,0.0474,"정형 데이터"],[0.1415,0.3358,0.2854,0.0498,"숫자로 명확하게 정의되고 구조화된 데이터"],[0.1415,0.3856,0.2607,0.0498,"짧은 텍스트, 날짜까지는 포함하기도 함"],[0.1415,0.4354,0.3927,0.0498,"쉽게 저장하고 관리할 수 있는 데이터로 분석 및 처리가 쉬움"],[0.1415,0.4851,0.3742,0.0498,"객관적인 측정 및 다양한 분석 도구를 활용해 분석이 가능"],[0.1196,0.5349,0.1099,0.0569,"비정형 데이터"],[0.1415,0.5918,0.5151,0.0498,"텍스트, 이미지, 오디오, 비디오 등 숫자나 문자로 쉽게 표현하기 어려운 데이터"],[0.1415,0.6416,0.2891,0.0498,"분석이나 처리가 정형 데이터에 비해 어려움"],[0.1196,0.6914,0.1099,0.0569,"반정형 데이터"],[0.1415,0.7482,0.4003,0.0498,"정형 데이터와 비정형 데이터의 중간적인 특성을 가진 데이터"],[0.1415,0.798,0.3755,0.0498,"일부 구조를 가지고 있지만, 완전히 정형화되지 않은 형태"],[0.1415,0.8478,0.2306,0.0498,"XML, JSON 등의 형식으로 저장"],[0.9638,0.9294,0.0082,0.0237,"7"],[0.8981,0.9637,0.0844,0.0253,"Ⅷ-1. 데이터 이해"]]},{"title":"실과 성취 기준","text":["[6실05-04] 디지털 데이터와 아날로그 데이터의 특징을 이해하고, 인공지능에 활용할 수 있는 데이터의 유형이나 형태를 탐색한다. 이 성취 기준은 놀이·체험을 중심으로 생활 주변 에서 접할 수 있는 디지털 및 아날로그 데이터를 찾아 각각의 특징을 비교하는 과정을 통해 데이터의 의미를 이해하고, 인공지능에 활용할 수 있는 숫자, 글자, 소리, 이미지 데이터의 유형이나 형태를 탐색할 수 있도록 한다.","[6실05-05] 인공지능이 만들어지는 과정을 체험하고, 인공지능이 사회에 미치는 영향을 탐색한 다.  이 성취 기준은 기계학습이 적용된 간단한 인공지능 도구의 체험을 통해 기계학습의 기본 원리를 이해하고 인공지능으로 인한 사회의 발전과 직업의 변화를 이해하여 인공지능이 사회에 미치는 영향을 탐색할 수 있어야 한다.","실과 성취 기준"],"image":"/images/lectures/computer-education2/3/008.webp","videos":[],"links":[],"sourcePage":8,"videoFrames":[],"kind":"native","labId":"standards"},{"title":"데이터의 유형","text":["데이터의 유형","9","Ⅷ-1. 데이터 이해"],"image":"/images/lectures/computer-education2/3/009.webp","videos":[],"links":[],"sourcePage":9,"videoFrames":[],"lines":[[0.0661,0.0751,0.2382,0.1067,"데이터의 유형"],[0.9638,0.9294,0.0082,0.0237,"9"],[0.8981,0.9637,0.0844,0.0253,"Ⅷ-1. 데이터 이해"]],"pictures":[{"src":"/images/lectures/computer-education2/3/pictures/5e5745f7c697492c.webp","x":0.1397,"y":0.2601,"width":0.7206,"height":0.687}]},{"title":"블록 코드와 JSON","text":["데이터의 유형","10","Ⅷ-1. 데이터 이해"],"image":"/images/lectures/computer-education2/3/010.webp","videos":[],"links":[],"sourcePage":10,"videoFrames":[],"kind":"lab","labId":"blocks"},{"title":"아날로그 데이터와 디지털 데이터","text":["아날로그 데이터와 디지털 데이터","11","아날로그 데이터","수치를 연속된 물리량으로 표현하는 방식","일정 범위 내에서 무한히 많은 값을 가질 수 있고, 연속해서 변화함","디지털 데이터","수치를 연속된 물리량이 아닌 일정한 간격의 불연속적인 값으로 표현하는 방식","컴퓨팅 시스템은 데이터를 0과 1로 표현"],"image":"/images/lectures/computer-education2/3/011.webp","videos":[],"links":[],"sourcePage":11,"videoFrames":[],"lines":[[0.0661,0.0751,0.5618,0.1067,"아날로그 데이터와 디지털 데이터"],[0.1196,0.2884,0.1268,0.0474,"아날로그 데이터"],[0.1415,0.3358,0.2706,0.0498,"수치를 연속된 물리량으로 표현하는 방식"],[0.1415,0.3856,0.3828,0.0498,"일정 범위 내에서 무한히 많은 값을 가질 수 있고, 연속해서"],[0.1415,0.4354,0.0482,0.0415,"변화함"],[0.1196,0.4768,0.1099,0.0569,"디지털 데이터"],[0.1415,0.5337,0.3669,0.0498,"수치를 연속된 물리량이 아닌 일정한 간격의 불연속적인"],[0.1415,0.5835,0.1445,0.0415,"값으로 표현하는 방식"],[0.1415,0.625,0.2662,0.0498,"컴퓨팅 시스템은 데이터를 0과 1로 표현"],[0.9576,0.9294,0.0144,0.0237,"11"]],"pictures":[{"src":"/images/lectures/computer-education2/3/pictures/0cef4c2fe8971433.webp","x":0.5458,"y":0.3438,"width":0.3882,"height":0.4556}]},{"title":"데이터 표현의 원리","text":["데이터 표현의 원리","12","2진수","0과 1의 두 가지 표현으로 각 자릿수를 표시","라이프니츠(Gottfried Wilhelm von Leibniz 1646~1716)","독일의 철학자, 법학자이면서 수학자","미적분과 함께 현대 대표 문명 기기인 컴퓨터가 탄생하는 데 결정적인 ‘0과 1’의 이분법을 개발"],"image":"/images/lectures/computer-education2/3/012.webp","videos":[],"links":[],"sourcePage":12,"videoFrames":[],"lines":[[0.0661,0.0751,0.3236,0.1067,"데이터 표현의 원리"],[0.1196,0.2884,0.0504,0.0474,"2진수"],[0.1415,0.3358,0.2884,0.0498,"0과 1의 두 가지 표현으로 각 자릿수를 표시"],[0.1415,0.3856,0.4455,0.0498,"라이프니츠(Gottfried Wilhelm von Leibniz 1646~1716)"],[0.1633,0.4354,0.2069,0.0427,"독일의 철학자, 법학자이면서 수학자"],[0.1633,0.478,0.5271,0.0427,"미적분과 함께 현대 대표 문명 기기인 컴퓨터가 탄생하는 데 결정적인 ‘0과 1’의 이분법을 개발"],[0.9576,0.9294,0.0144,0.0237,"12"]],"pictures":[{"src":"/images/lectures/computer-education2/3/pictures/cdea0d33d1a3cf42.webp","x":0.1569,"y":0.5852,"width":0.4994,"height":0.3445},{"src":"/images/lectures/computer-education2/3/pictures/b043a405a2c55f02.webp","x":0.6712,"y":0.5756,"width":0.1719,"height":0.3541}]},{"title":"데이터 표현의 원리","text":["데이터 표현의 원리","13","두 가지 정보 표현","컴퓨터 내부에서는 전기가 흐르거나(On) 흐르지 않는(Off) 두 가지 전기 신호만을 표현할 수 있는 트랜지스터를 이용하여 자료를 처리하고 저장","2진수 체계를 사용","컴퓨터는 전기가 흐를 경우 ‘1’, 흐르지 않을 경우 ‘0’으로 표현","비트(Bit)","컴퓨터의 정보 처리 단위 중에서 가장 작은 정보 단위","BInary digit","바이트(byte)","비트가 연속적으로 8개 모인 정보 단위"],"image":"/images/lectures/computer-education2/3/013.webp","videos":[],"links":[],"sourcePage":13,"videoFrames":[],"lines":[[0.0661,0.0751,0.3236,0.1067,"데이터 표현의 원리"],[0.1196,0.2884,0.1352,0.0474,"두 가지 정보 표현"],[0.1415,0.3358,0.324,0.0498,"컴퓨터 내부에서는 전기가 흐르거나(On) 흐르지"],[0.1415,0.3856,0.3232,0.0415,"않는(Off) 두 가지 전기 신호만을 표현할 수 있는"],[0.1415,0.4271,0.3003,0.0415,"트랜지스터를 이용하여 자료를 처리하고 저장"],[0.1415,0.4685,0.1257,0.0498,"2진수 체계를 사용"],[0.1633,0.5183,0.3214,0.0427,"컴퓨터는 전기가 흐를 경우 ‘1’, 흐르지 않을 경우 ‘0’으로"],[0.1633,0.561,0.0285,0.0356,"표현"],[0.1196,0.5965,0.0856,0.0569,"비트(Bit)"],[0.1415,0.6534,0.3445,0.0498,"컴퓨터의 정보 처리 단위 중에서 가장 작은 정보 단위"],[0.1415,0.7032,0.0987,0.0498,"BInary digit"],[0.1196,0.8028,0.1183,0.0569,"바이트(byte)"],[0.5406,0.2884,0.2554,0.0415,"비트가 연속적으로 8개 모인 정보 단위"],[0.9576,0.9294,0.0144,0.0237,"13"]],"pictures":[{"src":"/images/lectures/computer-education2/3/pictures/2cc97d40fee87d13.webp","x":0.3667,"y":0.7614,"width":0.5284,"height":0.2321},{"src":"/images/lectures/computer-education2/3/pictures/f15b48e2315c8fa1.webp","x":0.5225,"y":0.4763,"width":0.2167,"height":0.207}]},{"title":"정수 표현","text":["정수 표현","14","2진수","하나의 비트에 0과 1 두가지 값으로만 표현","보통 8비트(1바이트) 단위를 사용"],"image":"/images/lectures/computer-education2/3/014.webp","videos":[],"links":[],"sourcePage":14,"videoFrames":[],"lines":[[0.0661,0.0751,0.1618,0.1067,"정수 표현"],[0.1196,0.2884,0.0504,0.0474,"2진수"],[0.1415,0.3358,0.2847,0.0498,"하나의 비트에 0과 1 두가지 값으로만 표현"],[0.1415,0.3856,0.2293,0.0498,"보통 8비트(1바이트) 단위를 사용"],[0.9576,0.9294,0.0144,0.0237,"14"]],"pictures":[{"src":"/images/lectures/computer-education2/3/pictures/719953166febe82e.webp","x":0.0125,"y":0.4751,"width":0.5185,"height":0.4068},{"src":"/images/lectures/computer-education2/3/pictures/b7cba09d15e1d620.webp","x":0.5377,"y":0.4614,"width":0.4498,"height":0.4238}]},{"title":"정수 표현","text":["정수 표현","15","2진법의 사칙연산","10진법에서와 방법과 같음","2가 되면 자리올림이 발생"],"image":"/images/lectures/computer-education2/3/015.webp","videos":[],"links":[],"sourcePage":15,"videoFrames":[],"lines":[[0.0661,0.0751,0.1618,0.1067,"정수 표현"],[0.1196,0.2884,0.1392,0.0474,"2진법의 사칙연산"],[0.1415,0.3358,0.1811,0.0498,"10진법에서와 방법과 같음"],[0.1415,0.3856,0.1739,0.0498,"2가 되면 자리올림이 발생"],[0.9576,0.9294,0.0144,0.0237,"15"]],"pictures":[{"src":"/images/lectures/computer-education2/3/pictures/87d8999577d8d025.webp","x":0.2289,"y":0.6769,"width":0.5422,"height":0.2444},{"src":"/images/lectures/computer-education2/3/pictures/7a8e286abb27f64f.webp","x":0.263,"y":0.4685,"width":0.4739,"height":0.1793}]},{"title":"컴퓨터의 이진법","text":["컴퓨터의 이진법","컴퓨터 CPU(중앙처리장치=뇌)속의 트랜지스터가 안정된 출력을 하기 위해 0(OFF), 1(ON)의 이진법을 사용함","이진수를 사용하면 소수, 음수는 어떻게 표현할까?","더 많은 정보를 표현하거나 저장할 땐 어떻게?"],"image":"/images/lectures/computer-education2/3/016.webp","videos":[],"links":[],"sourcePage":16,"videoFrames":[],"lines":[[0.0661,0.0751,0.2764,0.1067,"컴퓨터의 이진법"],[0.6058,0.3841,0.2522,0.0415,"컴퓨터 CPU(중앙처리장치=뇌)속의"],[0.6058,0.4255,0.3224,0.0415,"트랜지스터가 안정된 출력을 하기 위해 0(OFF),"],[0.6058,0.467,0.1786,0.0415,"1(ON)의 이진법을 사용함"],[0.6017,0.5288,0.3299,0.0415,"이진수를 사용하면 소수, 음수는 어떻게 표현할까?"],[0.6015,0.5729,0.2989,0.0415,"더 많은 정보를 표현하거나 저장할 땐 어떻게?"]],"pictures":[{"src":"/images/lectures/computer-education2/3/pictures/884363afcba16185.webp","x":0.0958,"y":0.2848,"width":0.3548,"height":0.5828}]},{"title":"정수 표현","text":["정수 표현","17","이진수의 음수표현: 1의 보수: 주어진 이진수의 비트를 0은 1로, 1은 0으로 각각 변환하는 방법","1의 보수(1’s complement)","이진수 0100의 1의 보수는 1011","0이 +0과 -0으로 각각 다르다는 단점 (0이 2개가 된다!)","+0은 0000이고 -0은 1111"],"image":"/images/lectures/computer-education2/3/017.webp","videos":[],"links":[],"sourcePage":17,"videoFrames":[],"lines":[[0.0661,0.0751,0.1618,0.1067,"정수 표현"],[0.1196,0.2884,0.7186,0.0474,"이진수의 음수표현: 1의 보수: 주어진 이진수의 비트를 0은 1로, 1은 0으로 각각 변환하는 방법"],[0.1196,0.3358,0.2439,0.0569,"1의 보수(1’s complement)"],[0.1415,0.3927,0.2346,0.0498,"이진수 0100의 1의 보수는 1011"],[0.1415,0.4425,0.3816,0.0498,"0이 +0과 -0으로 각각 다르다는 단점 (0이 2개가 된다!)"],[0.1415,0.4922,0.2048,0.0498,"+0은 0000이고 -0은 1111"],[0.9576,0.9294,0.0144,0.0237,"17"]],"pictures":[{"src":"/images/lectures/computer-education2/3/pictures/04368aba3045fe14.webp","x":0.6132,"y":0.3474,"width":0.2955,"height":0.6277},{"src":"/images/lectures/computer-education2/3/pictures/d3a1183106ca4ba2.webp","x":0.1174,"y":0.5729,"width":0.4625,"height":0.3509}]},{"title":"정수 표현","text":["정수 표현","18","https://blog.naver.com/errorsoft666/222084161544","이진수의 음수표현: 2의 보수: 1의 보수의 단점을 보완하고 4비트에서 -8에서 +7까지 표현 가능","부호 비트(sign bit)","가장 왼쪽의 비트를 최상위 비트","2의 보수 모두 음수는 4비트의 가장 왼쪽 비트가 1","2의 보수 변환 방법"],"image":"/images/lectures/computer-education2/3/018.webp","videos":[],"links":["https://blog.naver.com/errorsoft666/222084161544"],"sourcePage":18,"videoFrames":[],"lines":[[0.0661,0.0751,0.1618,0.1067,"정수 표현"],[0.1196,0.2884,0.7342,0.0474,"이진수의 음수표현: 2의 보수: 1의 보수의 단점을 보완하고 4비트에서 -8에서 +7까지 표현 가능"],[0.1196,0.3358,0.1629,0.0569,"부호 비트(sign bit)"],[0.1415,0.3927,0.2112,0.0498,"가장 왼쪽의 비트를 최상위 비트"],[0.1415,0.4425,0.3326,0.0498,"2의 보수 모두 음수는 4비트의 가장 왼쪽 비트가 1"],[0.1196,0.4922,0.1434,0.0569,"2의 보수 변환 방법"],[0.9576,0.9294,0.0144,0.0237,"18"],[0.6794,0.9637,0.303,0.0253,"https://blog.naver.com/errorsoft666/222084161544"]],"pictures":[{"src":"/images/lectures/computer-education2/3/pictures/86bfbee5eee2305c.webp","x":0.4182,"y":0.4281,"width":0.5277,"height":0.5013},{"src":"/images/lectures/computer-education2/3/pictures/37bef70476a211c8.webp","x":0.0519,"y":0.6154,"width":0.3661,"height":0.2491}]},{"kind":"lab","title":"8비트로 숫자 표현하기","text":["8비트로 숫자 표현하기"],"videos":[],"videoFrames":[],"links":[]},{"title":"실수 표현","text":["실수 표현","19","고정(Fixed)소수점 표현","소수점을 사용하여 고정된 자리수의 소수를 나타내는 방법","16비트를 사용하는 경우 앞의 8비트는 정수 부분 을 뒤의 8비트는 소수 부분을 표현하는 방식","구현하기가 편하고 연산속도가 빠름","수의 범위나 정밀도가 낮아 일반적인 컴퓨터에서는 잘 사용하지 않음"],"image":"/images/lectures/computer-education2/3/019.webp","videos":[],"links":[],"sourcePage":19,"videoFrames":[],"lines":[[0.0661,0.0751,0.1618,0.1067,"실수 표현"],[0.1196,0.2884,0.1957,0.0474,"고정(Fixed)소수점 표현"],[0.1415,0.3358,0.2854,0.0498,"소수점을 사용하여 고정된 자리수의 소수를"],[0.1415,0.3856,0.0964,0.0415,"나타내는 방법"],[0.1415,0.4271,0.2919,0.0498,"16비트를 사용하는 경우 앞의 8비트는 정수"],[0.1415,0.4768,0.2887,0.0415,"부분 을 뒤의 8비트는 소수 부분을 표현하는"],[0.1415,0.5183,0.0333,0.0415,"방식"],[0.1415,0.5598,0.2372,0.0498,"구현하기가 편하고 연산속도가 빠름"],[0.1415,0.6096,0.2409,0.0498,"수의 범위나 정밀도가 낮아 일반적인"],[0.1415,0.6594,0.2039,0.0415,"컴퓨터에서는 잘 사용하지 않음"],[0.9576,0.9294,0.0144,0.0237,"19"]],"pictures":[{"src":"/images/lectures/computer-education2/3/pictures/d9af0db9f5434eab.webp","x":0.4541,"y":0.3316,"width":0.4971,"height":0.2568},{"src":"/images/lectures/computer-education2/3/pictures/046319f18ca21afc.webp","x":0.4541,"y":0.6239,"width":0.4971,"height":0.1499}]},{"title":"부동소수점, 소수점의 위치를 따로 기억해요","text":["고정소수점과 부동소수점 비교","9.6875 = 1001.1011₂ = 1.0011011₂ × 2³","소수점 오른쪽의 자릿값 0.5, 0.25, 0.125, 0.0625","정규화, 부호 1비트, 지수 8비트, 가수의 소수 부분 23비트","실제 지수 3 + 127 = 저장 지수 130","정규수의 첫 자리 1은 생략한다"],"image":"/images/lectures/computer-education2/3/020.webp","videos":[],"links":[],"sourcePage":20,"videoFrames":[],"kind":"native","labId":"floatIntro"},{"title":"부동소수점, 세 부분 바꾸기","text":["9.6875 부동소수점 체험","부호 변경, 두 배, 절반","지수와 가수, 32비트 직접 편집","0.1의 반올림과 특별한 값"],"image":"/images/lectures/computer-education2/3/020.webp","videos":[],"links":[],"sourcePage":20,"videoFrames":[],"kind":"lab","labId":"float"},{"title":"문자 표현","text":["문자 표현","21","ASCII(미국에서 표준화한 정보교환용 부호체계)","American Standard Code for information Interchange","7비트를 사용하여 128개의 문자, 숫자, 특수문자 코드를 규정","아스키코드가 7비트를 이용하지만 실제로 한 문자는 1바이트에 저장","한 문자에 시작은 0으로, 나머지는 코드 값으로 구성"],"image":"/images/lectures/computer-education2/3/021.webp","videos":[],"links":[],"sourcePage":21,"videoFrames":[],"lines":[[0.0661,0.0751,0.1618,0.1067,"문자 표현"],[0.1196,0.2884,0.375,0.0474,"ASCII(미국에서 표준화한 정보교환용 부호체계)"],[0.1415,0.3358,0.4483,0.0498,"American Standard Code for information Interchange"],[0.1633,0.3856,0.3495,0.0427,"7비트를 사용하여 128개의 문자, 숫자, 특수문자 코드를 규정"],[0.1415,0.4282,0.4516,0.0498,"아스키코드가 7비트를 이용하지만 실제로 한 문자는 1바이트에 저장"],[0.1633,0.478,0.292,0.0427,"한 문자에 시작은 0으로, 나머지는 코드 값으로 구성"],[0.9576,0.9294,0.0144,0.0237,"21"]],"pictures":[{"src":"/images/lectures/computer-education2/3/pictures/1c0fab209c90bced.webp","x":0.1504,"y":0.5547,"width":0.6375,"height":0.4281},{"src":"/images/lectures/computer-education2/3/pictures/151001ca124825f0.webp","x":0.6554,"y":0.3074,"width":0.3209,"height":0.2353}]},{"title":"문자 표현","text":["문자 표현","22","ASCII코드로 화성에서 살아남기"],"image":"/images/lectures/computer-education2/3/022.webp","videos":["/media/lectures/computer-education2/e6744d2a797de862.mp4"],"links":[],"sourcePage":22,"videoFrames":[{"src":"/media/lectures/computer-education2/e6744d2a797de862.mp4","x":0.2475308,"y":0.4067901,"width":0.5049383,"height":0.5049383}],"lines":[[0.0661,0.0751,0.1618,0.1067,"문자 표현"],[0.0918,0.289,0.3419,0.0652,"ASCII코드로 화성에서 살아남기"],[0.9576,0.9294,0.0144,0.0237,"22"]]},{"title":"문자 표현","text":["문자 표현","23","유니코드","전 세계의 문자를 표현할 수 있도록 설계된 국제 표준 코드로 16비트로 구성","한글은 11,172자로 구성"],"image":"/images/lectures/computer-education2/3/023.webp","videos":[],"links":[],"sourcePage":23,"videoFrames":[],"lines":[[0.0661,0.0751,0.1618,0.1067,"문자 표현"],[0.1196,0.2884,0.0719,0.0474,"유니코드"],[0.1415,0.3358,0.3445,0.0498,"전 세계의 문자를 표현할 수 있도록 설계된 국제 표준"],[0.1415,0.3856,0.1514,0.0415,"코드로 16비트로 구성"],[0.1415,0.4271,0.174,0.0498,"한글은 11,172자로 구성"],[0.9576,0.9294,0.0144,0.0237,"23"]],"pictures":[{"src":"/images/lectures/computer-education2/3/pictures/c422bc892a004759.webp","x":0.5306,"y":0.2778,"width":0.3721,"height":0.6246},{"src":"/images/lectures/computer-education2/3/pictures/d30e8f6d17902ea4.webp","x":0.0736,"y":0.5301,"width":0.4396,"height":0.362}]},{"title":"유니코드와 문자 인코딩","text":["문자 표현","23","유니코드","전 세계의 문자를 표현할 수 있도록 설계된 국제 표준 코드로 16비트로 구성","한글은 11,172자로 구성"],"image":"/images/lectures/computer-education2/3/023.webp","videos":[],"links":[],"sourcePage":23,"videoFrames":[],"kind":"lab","labId":"unicode"},{"title":"이미지 표현","text":["이미지 표현","24","벡터 방식","벡터는 수학적 방정식을 사용하여 선, 면, 도형 등을 정의하고 이미지를 표현","이미지의 크기를 자유롭게 변경해도 품질이 유지되며 편집이 용이","실제 대상을 사실적으로 표현하는데 어려움이 있음","Ex) ai, swf, svg…","비트맵 방식","픽셀이라는 작은 색 점들의 모임으로 이미지를 표현","실제 대상을 그대로 표현하는데 강점","파일 용량이 크고 이미지 크기를 변경하면 품질이 저하됨","Ex) bmp, gif, jpg, png…"],"image":"/images/lectures/computer-education2/3/024.webp","videos":[],"links":[],"sourcePage":24,"videoFrames":[],"lines":[[0.0661,0.0751,0.2,0.1067,"이미지 표현"],[0.1196,0.2884,0.076,0.0474,"벡터 방식"],[0.1415,0.3358,0.399,0.0498,"벡터는 수학적 방정식을 사용하여 선, 면, 도형 등을 정의하고"],[0.1415,0.3856,0.0964,0.0415,"이미지를 표현"],[0.1415,0.4271,0.3966,0.0498,"이미지의 크기를 자유롭게 변경해도 품질이 유지되며 편집이"],[0.1415,0.4768,0.0333,0.0415,"용이"],[0.1415,0.5183,0.3336,0.0498,"실제 대상을 사실적으로 표현하는데 어려움이 있음"],[0.1415,0.5681,0.142,0.0498,"Ex) ai, swf, svg…"],[0.1196,0.6179,0.093,0.0569,"비트맵 방식"],[0.1415,0.6748,0.3372,0.0498,"픽셀이라는 작은 색 점들의 모임으로 이미지를 표현"],[0.1415,0.7245,0.2409,0.0498,"실제 대상을 그대로 표현하는데 강점"],[0.1415,0.7743,0.3706,0.0498,"파일 용량이 크고 이미지 크기를 변경하면 품질이 저하됨"],[0.1415,0.8241,0.1903,0.0498,"Ex) bmp, gif, jpg, png…"],[0.9576,0.9294,0.0144,0.0237,"24"]],"pictures":[{"src":"/images/lectures/computer-education2/3/pictures/4e4d133c9c43efaa.webp","x":0.5616,"y":0.3332,"width":0.3649,"height":0.5648}]},{"title":"이미지 표현","text":["이미지 표현","25","SVG 표현의 예","<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"900\" height=\"600\" viewBox=\"-72 -48 144 96\">    <path fill=\"#fff\" d=\"M-72-48v96H72v-96z\"/>    <g stroke=\"#000\" stroke-width=\"4\">        <path transform=\"rotate(33.69006752598)\" d=\"M-50-12v24m6 0v-24m6 0v24m76 0V1m0-2v-11m6 0v11m0 2v11m6 0V1m0-2v-11\"/>        <path transform=\"rotate(-33.69006752598)\" d=\"M-50-12v24m6 0V1m0-2v-11m6 0v24m76 0V1m0-2v-11m6 0v24m6 0V1m0-2v-11\"/>    </g>    <g transform=\"rotate(33.69006752598)\">        <path fill=\"#cd2e3a\" d=\"M12 0a18 18 0 11-36 0 24 24 0 1148 0\"/>        <path fill=\"#0047a0\" d=\"M0 0a12 12 0 1124 0 24 24 0 11-48 0 12 12 0 1024 0\"/>    </g></svg>"],"image":"/images/lectures/computer-education2/3/025.webp","videos":[],"links":[],"sourcePage":25,"videoFrames":[],"lines":[[0.0661,0.0751,0.2,0.1067,"이미지 표현"],[0.1196,0.2884,0.1222,0.0474,"SVG 표현의 예"],[0.1196,0.3927,0.4101,0.0391,"<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"900\" height=\"600\""],[0.1196,0.4318,0.1632,0.0326,"viewBox=\"-72 -48 144 96\">"],[0.1269,0.4644,0.2699,0.0326,"<path fill=\"#fff\" d=\"M-72-48v96H72v-96z\"/>"],[0.1269,0.497,0.2205,0.0326,"<g stroke=\"#000\" stroke-width=\"4\">"],[0.1342,0.5296,0.3948,0.0326,"<path transform=\"rotate(33.69006752598)\" d=\"M-50-12v24m6 0v-"],[0.1196,0.5622