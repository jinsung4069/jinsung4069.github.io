0.289,0.2333,0.0652,"학습 활동 개요 (예시)"],[0.3051,0.4148,0.3668,0.0533,"강아지 집  찾기 놀이를 통해 반복 구조 알기"],[0.183,0.5818,0.4111,0.0622,"학습 주제 : 강아지 집 찾기 놀이를 통해 반복 구조에 대해 알기"],[0.183,0.644,0.4457,0.0622,"학습 목표 : 강아지 집 찾기 놀이를 통해 반복 구조에 대해 이해한다."],[0.183,0.7062,0.2701,0.0622,"학습 자료 : 컴퓨터, 수업용 PPT, 활동지"],[0.183,0.7684,0.2378,0.0622,"대상 학년 및 교과 : 5~6학년, 실과"],[0.183,0.8306,0.4705,0.0548,"중점 CT 요소 :      분해       패턴인식       추상화       알고리즘        자동화"]]},{"title":"CT/CS 기반 문제 해결 수업 설계하기","text":["CT/CS 기반 문제 해결 수업 설계하기","02. 학습 활동 계획 세우기","ㅜㄱ우기","동기유발","학습정리","활동1","활동2","활동3","도입","전개","정리","위의 단계는 어디까지나 일반적인 예시입니다.","수업 모형을 적용할 때에는 수업모형단계에 따라 구성할 수 있습니다.","위에서 설정한 수업 주제에 따른 학습 활동을 단계별로 계획해 보겠습니다."],"image":"/images/lectures/computer-education2/5/035.webp","videos":[],"links":[],"sourcePage":35,"videoFrames":[],"lines":[[0.0661,0.0751,0.6405,0.1067,"CT/CS 기반 문제 해결 수업 설계하기"],[0.0918,0.289,0.281,0.0652,"02. 학습 활동 계획 세우기"],[0.1857,0.4396,0.045,0.0296,"동기유발"],[0.3246,0.4396,0.0315,0.0296,"활동1"],[0.4568,0.4396,0.0315,0.0296,"활동2"],[0.5891,0.4396,0.0315,0.0296,"활동3"],[0.7209,0.4396,0.045,0.0296,"학습정리"],[0.4536,0.4883,0.0677,0.0474,"ㅜㄱ우기"],[0.1834,0.5752,0.0297,0.0415,"도입"],[0.3156,0.5752,0.0333,0.0415,"전개"],[0.7185,0.5752,0.0333,0.0415,"정리"],[0.1842,0.6681,0.3089,0.0622,"위의 단계는 어디까지나 일반적인 예시입니다."],[0.1842,0.7304,0.4534,0.0622,"수업 모형을 적용할 때에는 수업모형단계에 따라 구성할 수 있습니다."],[0.1842,0.7926,0.4904,0.0548,"위에서 설정한 수업 주제에 따른 학습 활동을 단계별로 계획해 보겠습니다."]]},{"title":"CT/CS 기반 문제 해결 수업 설계하기","text":["CT/CS 기반 문제 해결 수업 설계하기","학습 활동 계획 시 고려 사항","학습목표 달성을 위한 활동을 계획하되 활동 간에 유기적인 연계가 이루어질 수 있도록 합니다. 간단하게 학습 활동 계획 후에는 세부적인 활동 계획을 수립합니다.","01","앞에서 정한 수업 주제와 관련이 있는 학습활동을 2-3개 정도 선정해 봅시다.","02"],"image":"/images/lectures/computer-education2/5/036.webp","videos":[],"links":[],"sourcePage":36,"videoFrames":[],"lines":[[0.0661,0.0751,0.6405,0.1067,"CT/CS 기반 문제 해결 수업 설계하기"],[0.0918,0.289,0.2918,0.0652,"학습 활동 계획 시 고려 사항"],[0.164,0.4081,0.7247,0.0533,"학습목표 달성을 위한 활동을 계획하되 활동 간에 유기적인 연계가 이루어질 수 있도록"],[0.164,0.4614,0.073,0.0533,"합니다."],[0.164,0.5148,0.5642,0.0533,"간단하게 학습 활동 계획 후에는 세부적인 활동 계획을 수립합니다."],[0.0929,0.4549,0.034,0.0665,"01"],[0.0929,0.6844,0.034,0.0665,"02"],[0.164,0.6939,0.5757,0.0474,"앞에서 정한 수업 주제와 관련이 있는 학습활동을 2-3개 정도 선정해 봅시다."]]},{"title":"CT/CS 기반 문제 해결 수업 설계하기","text":["CT/CS 기반 문제 해결 수업 설계하기","학습 활동 계획 세우기 (예시)","ㅜㄱ우기","동기유발",": 관련 경험","나누기","학습정리",": 학습 내용","정리하기","활동1",": 문제 상황 이해하기","활동2",": 문제해결","방법 찾기","활동3",": 문제해결하기","도입","전개","정리","강아지 집  찾기 놀이를 통해 반복 구조 알기"],"image":"/images/lectures/computer-education2/5/037.webp","videos":[],"links":[],"sourcePage":37,"videoFrames":[],"lines":[[0.0661,0.0751,0.6405,0.1067,"CT/CS 기반 문제 해결 수업 설계하기"],[0.0918,0.289,0.3092,0.0652,"학습 활동 계획 세우기 (예시)"],[0.3345,0.4155,0.3253,0.0474,"강아지 집  찾기 놀이를 통해 반복 구조 알기"],[0.1564,0.5711,0.0405,0.0267,"동기유발"],[0.1517,0.5978,0.0523,0.0267,": 관련 경험"],[0.1612,0.6244,0.0286,0.0267,"나누기"],[0.3154,0.5844,0.0284,0.0267,"활동1"],[0.2844,0.6111,0.0882,0.0267,": 문제 상황 이해하기"],[0.4684,0.5711,0.0284,0.0267,"활동2"],[0.4587,0.5978,0.0477,0.0267,": 문제해결"],[0.4611,0.6244,0.0429,0.0267,"방법 찾기"],[0.6213,0.5844,0.0284,0.0267,"활동3"],[0.6021,0.6111,0.0644,0.0267,": 문제해결하기"],[0.7754,0.5711,0.0405,0.0267,"학습정리"],[0.7707,0.5978,0.05,0.0267,": 학습 내용"],[0.7754,0.6244,0.0382,0.0267,"정리하기"],[0.4703,0.6227,0.0594,0.0415,"ㅜㄱ우기"],[0.1529,0.7228,0.0254,0.0356,"도입"],[0.3058,0.7228,0.0285,0.0356,"전개"],[0.7718,0.7228,0.0285,0.0356,"정리"]]},{"title":"CT/CS 기반 문제 해결 수업 설계하기","text":["CT/CS 기반 문제 해결 수업 설계하기","학습 활동 계획 세우기 (예시)","ㅜㄱ우기","동기유발",": 관련 경험","나누기","학습정리",": 학습 내용","정리하기","활동1",": 문제 상황 이해하기","활동2",": 문제해결","방법 찾기","활동3",": 문제해결하기","도입","전개","정리","강아지 집  찾기 놀이를 통해 반복 구조 알기","강아지 집을 찾아주어야 하는 문제 상황 제시하기","주어진 조건(화살표방향, 반복..)에 따라 문제","해결방법 찾기","강아지 집 찾아주기 문제 해결 및 놀이 속 반복구조 알기"],"image":"/images/lectures/computer-education2/5/038.webp","videos":[],"links":[],"sourcePage":38,"videoFrames":[],"lines":[[0.0661,0.0751,0.6405,0.1067,"CT/CS 기반 문제 해결 수업 설계하기"],[0.0918,0.289,0.3092,0.0652,"학습 활동 계획 세우기 (예시)"],[0.3345,0.4155,0.3253,0.0474,