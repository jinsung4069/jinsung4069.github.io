.0569,"초국가성"],[0.1196,0.4496,0.1141,0.0569,"낮은 위험 인식"],[0.1196,0.5065,0.1479,0.0569,"피해 확산의 용이성"],[0.1196,0.5634,0.1987,0.0569,"피해 입증과 규제의 어려움"]],"pictures":[{"src":"/images/lectures/computer-education2/10/pictures/cb2102afd973d304.webp","x":0.4875,"y":0.2602,"width":0.4667,"height":0.6752}]},{"title":"사이버 폭력의 유형","text":["사이버 폭력의 유형"],"image":"/images/lectures/computer-education2/10/012.webp","videos":[],"links":[],"sourcePage":12,"videoFrames":[],"lines":[[0.0661,0.0751,0.3236,0.1067,"사이버 폭력의 유형"]],"pictures":[{"src":"/images/lectures/computer-education2/10/pictures/35f084c2baa00244.webp","x":0.1833,"y":0.2605,"width":0.6333,"height":0.6747}]},{"title":"사이버 폭력의 유형별 피해 경험","text":["사이버 폭력의 유형별 피해 경험"],"image":"/images/lectures/computer-education2/10/013.webp","videos":[],"links":[],"sourcePage":13,"videoFrames":[],"lines":[[0.0661,0.0751,0.5326,0.1067,"사이버 폭력의 유형별 피해 경험"]],"pictures":[{"src":"/images/lectures/computer-education2/10/pictures/0425078d9097fff7.webp","x":0.3167,"y":0.2657,"width":0.3667,"height":0.6642}]},{"title":"사이버 폭력 예방","text":["사이버 폭력 예방","온라인 공간에서의 예의를 인식","자신의 개인정보는 함부로 공개하지 않고, 타인의 개인정보를 존중하며 공유하지 않는 것이 중요","소셜 미디어나 온라인 커뮤니티에서 타인을 비방하거나 욕설하는 행위는 사이버폭력에 해당","온라인에서의 행동도 실제 생활에서의 행동과 마찬가지로 책임이 따름","사이버폭력을 목격하거나 경험했을 때, 침묵하지 말고 적극적으로 대응","온라인 공간에서 긍정적인 문화를 만들기 위해 노력","온라인 정보를 이해하고 판단하는 능력을 키우기","온라인 상에서도 타인의 감정을 이해하고 공감하는 능력이 필요","사이버폭력에 대한 지속적인 교육과 인식 제고","사이버 폭력 예방"],"image":"/images/lectures/computer-education2/10/014.webp","videos":[],"links":[],"sourcePage":14,"videoFrames":[],"lines":[[0.0661,0.0751,0.2854,0.1067,"사이버 폭력 예방"],[0.0918,0.289,0.1751,0.0652,"사이버 폭력 예방"],[0.1196,0.4113,0.2221,0.0444,"온라인 공간에서의 예의를 인식"],[0.1196,0.4557,0.6717,0.0533,"자신의 개인정보는 함부로 공개하지 않고, 타인의 개인정보를 존중하며 공유하지 않는 것이 중요"],[0.1196,0.5091,0.6427,0.0533,"소셜 미디어나 온라인 커뮤니티에서 타인을 비방하거나 욕설하는 행위는 사이버폭력에 해당"],[0.1196,0.5624,0.4919,0.0533,"온라인에서의 행동도 실제 생활에서의 행동과 마찬가지로 책임이 따름"],[0.1196,0.6157,0.4972,0.0533,"사이버폭력을 목격하거나 경험했을 때, 침묵하지 말고 적극적으로 대응"],[0.1196,0.6691,0.3609,0.0533,