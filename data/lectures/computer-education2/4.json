단하고 특정 위치의 데이터에 접근할 필요가 없음","데이터 추출 시 앞서 삽입된 데이터들이 메모리에 남아 메모리 낭비가 발생","큐가 가득차면 데이터를 삽입하기 전에 기존 데이터를 삭제해야 함"],"image":"/images/lectures/computer-education2/4/011.webp","videos":[],"links":[],"sourcePage":11,"videoFrames":[],"lines":[[0.0661,0.0751,0.1618,0.1067,"선형 구조"],[0.1196,0.2884,0.0211,0.0474,"큐"],[0.1415,0.3358,0.3505,0.0498,"먼저 삽입된 데이터가 가장 먼저 추출되는 FIFO 구조"],[0.1415,0.3856,0.2297,0.0498,"먼저 들어온 것이 먼저 나가는 구조"],[0.1415,0.4354,0.5188,0.0498,"번호표를 받아 기다리는 사람들이 먼저 온 사람부터 업무를 보는 것과 같은 원리"],[0.1415,0.4851,0.3854,0.0498,"구현이 간단하고 특정 위치의 데이터에 접근할 필요가 없음"],[0.1415,0.5349,0.4854,0.0498,"데이터 추출 시 앞서 삽입된 데이터들이 메모리에 남아 메모리 낭비가 발생"],[0.1415,0.5847,0.43,0.0498,"큐가 가득차면 데이터를 삽입하기 전에 기존 데이터를 삭제해야 함"],[0.9576,0.9294,0.0144,0.0237,"11"]],"pictures":[{"src":"/images/lectures/computer-education2/4/pictures/d7e17705cc008f64.webp","x":0.7231,"y":0.4949,"width":0.231,"height":0.4107},{"src":"/images/lectures/computer-education2/4/pictures/90e4cbbc8c203533.webp","x":0.3167,"y":0.6796,"width":0.3866,"height":0.226}]},{"kind":"lab","title":"스택과 큐 비교하기","text":["스택과 큐 비교하기"],"videos":[],"videoFrames":[],"links":[],"labId":"stackQueue"},{"title":"선형 구조","text":["선형 구조","12","언제 사용할까?","주기억장치의 구조","주소","메모리의 저장소는 주소(address)를 이용하여 각각 바이트 단위로 고유하게 식별","컴퓨터가 한 번에 작업할 수 있는 데이터의 단위를 워드"],"image":"/images/lectures/computer-education2/4/012.webp","videos":[],"links":[],"sourcePage":12,"videoFrames":[],"lines":[[0.0661,0.0751,0.1618,0.1067,"선형 구조"],[0.1196,0.2884,0.1211,0.0474,"언제 사용할까?"],[0.1196,0.3358,0.1437,0.0569,"주기억장치의 구조"],[0.1415,0.3927,0.0333,0.0498,"주소"],[0.1633,0.4425,0.4667,0.0427,"메모리의 저장소는 주소(address)를 이용하여 각각 바이트 단위로 고유하게 식별"],[0.1633,0.4851,0.3069,0.0427,"컴퓨터가 한 번에 작업할 수 있는 데이터의 단위를 워드"],[0.9576,0.9294,0.0144,0.0237,"12"]],"pictures":[{"src":"/images/lectures/computer-education2/4/pictures/725306895428f74d.webp","x":0.5333,"y":0.4926,"width":0.4173,"height":0.4191}]},{"title":"선형 구조","text":["선형 구조","13","선형 구조의 연산","식의 표현","중위 표기식 : A * B / C","후위 표기식 : A B * C /","전위 표기식 : / * A B C","후위 표기식의 장점:","괄호가 불필요","연산자의 우선 순위가 무의미","계산 과정이 간단(왼편에서 오른편으로 스캔)","A+(B*C)의 후위 표기법","B*C의 *기호를 뒤로 보낸다. →A+BC*","+기호를 뒤로 보낸다. → ABC*+","8/((4-2)*2)의 후위 표기법","연산자를 뒤로 보낸다. 8((42-)2*)/  ※ 가장 먼저 나온 연산자가 가장 뒤로!","괄호를 제거하여 완성한다. 842-2*/"],"image":"/images/lectures/computer-education2/4/013.webp","videos":[],"links":[],"sourcePage":13,"videoFrames":[],"lines":[[0.0661,0.0751,0.1618,0.1067,"선형 구조"],[0.1196,0.2884,0.131,0.0474,"선형 구조의 연산"],[0.1196,0.3358,0.076,0.0569,"식의 표현"],[0.1415,0.3927,0.1651,0.0498,"중위 표기식 : A * B / C"],[0.1415,0.4425,0.1651,0.0498,"후위 표기식 : A B * C /"],[0.1415,0.4922,0.1651,0.0498,"전위 표기식 : / * A B C"],[0.1196,0.542,0.1564,0.0569,"후위 표기식의 장점:"],[0.1415,0.5989,0.0964,0.0498,"괄호가 불필요"],[0.1415,0.6487,0.1927,0.0498,"연산자의 우선 순위가 무의미"],[0.1415,0.6985,0.3003,0.0498,"계산 과정이 간단(왼편에서 오른편으로 스캔)"],[0.5321,0.2884,0.2016,0.0474,"A+(B*C)의 후위 표기법"],[0.5415,0.3358,0.3219,0.0569,"B*C의 *기호를 뒤로 보낸다. →A+BC*"],[0.5415,0.3927,0.2715,0.0569,"+기호를 뒤로 보낸다. → ABC*+"],[0.5321,0.5065,0.226,0.0569,"8/((4-2)*2)의 후위 표기법"],[0.5415,0.5634,0.2949,0.0569,"연산자를 뒤로 보낸다. 8((42-)2*)/"],[0.5415,0.6202,0.294,0.0474,"※ 가장 먼저 나온 연산자가 가장 뒤로!"],[0.5415,0.6677,0.2864,0.0569,"괄호를 제거하여 완성한다. 842-2*/"],[0.9576,0.9294,0.0144,0.0237,"13"]]},{"title":"스택에 값이 저장되는 과정","text":["후위 표기식 842-2*/","왼쪽부터 단계별 스택 계산"],"videos":[],"links":[],"sourcePage":14,"videoFrames":[],"kind":"lab","labId":"postfix"},{"title":"선형 구조","text":["선형 구조","15"],"image":"/images/lectures/computer-education2/4/015.webp","videos":["/media/lectures/computer-education2/a35ed761c74e3e60.mp4"],"links":[],"sourcePage":15,"videoFrames":[{"src":"/media/lectures/computer-education2/a35ed761c74e3e60.mp4","x":0.1861111,"y":0.2839506,"width":0.6277778,"height":0.6277778}],"lines":[[0.0661,0.0751,0.1618,0.1067,"선형 구조"],[0.9576,0.9294,0.0144,0.0237,"15"]]},{"title":"비선형 구조","text":["비선형 구조","16","트리","데이터를 계층적인 구조로 저장","데이터들을 부모-자식 관계로 연결","데이터 간의 관계를 효율적으로 표현하고 관리하는데 유용","이진 트리, n진 트리, 균형 트리 등이 있음"],"image":"/images/lectures/computer-e