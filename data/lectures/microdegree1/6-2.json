303,0.0677,0.062,"생성 전"],[0.3129,0.5923,0.1454,0.0492,"요청문에 개인정보가"],[0.3435,0.6415,0.0803,0.0436,"없는지 확인"],[0.585,0.5303,0.0677,0.062,"검증 중"],[0.5686,0.5923,0.0994,0.0492,"판정과 근거를"],[0.5591,0.6415,0.1147,0.0436,"짝과 교사가 확인"],[0.8178,0.5303,0.0677,0.062,"제출 후"],[0.7983,0.5923,0.1056,0.0492,"AI 사용 표시와"],[0.7995,0.6415,0.0994,0.0436,"수정 기록 확인"],[0.7745,0.9408,0.2148,0.0335,"출처: OpenAI(2026), Terms of Use"]]},{"title":"성찰과 다음 행동","text":["오늘 검증한 결과에서 가장 찾기 어려웠던 오류는 무엇이었나요?","그 오류를 학생이 스스로 찾게 하려면 어떤 질문이 필요할까요?","내 수업에서 AI 결과를 쓰는 장면 하나를 떠올리고 확인 단계를 어디에 넣을지 정해 봅니다.","8주차 개인별 AI 활용안에 판정표와 AI 사용 기록을 어떻게 넣을지 적어 봅니다.","성찰과 다음 행동"],"links":[],"sourcePage":48,"image":"/images/lectures/microdegree1/6-2/048.webp","lines":[[0.0156,0.032,0.1451,0.0536,"성찰과 다음 행동"],[0.0955,0.161,0.5457,0.062,"오늘 검증한 결과에서 가장 찾기 어려웠던 오류는 무엇이었나요?"],[0.1202,0.223,0.4597,0.0553,"그 오류를 학생이 스스로 찾게 하려면 어떤 질문이 필요할까요?"],[0.0955,0.2783,0.7618,0.062,"내 수업에서 AI 결과를 쓰는 장면 하나를 떠올리고 확인 단계를 어디에 넣을지 정해 봅니다."],[0.0955,0.3403,0.6697,0.0536,"8주차 개인별 AI 활용안에 판정표와 AI 사용 기록을 어떻게 넣을지 적어 봅니다."]]}]}
