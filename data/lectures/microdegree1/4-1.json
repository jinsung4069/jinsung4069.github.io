"],[0.1202,0.2079,0.1991,0.0553,"세로로 배열된 격자입니다."],[0.1202,0.2632,0.3357,0.0469,"각 픽셀은 빨강, 초록, 파랑 빛의 세기를 0부터"],[0.1202,0.3101,0.235,0.0553,"255까지의 값으로 저장합니다."],[0.1202,0.3655,0.3212,0.0469,"같은 크기에 픽셀이 많을수록 해상도가 높아"],[0.1202,0.4124,0.1415,0.0469,"세밀하게 보입니다."],[0.6906,0.8094,0.0737,0.0335,"픽셀과 해상도"],[0.6938,0.9408,0.2956,0.0335,"출처: 박정호(2025), AI융합교육의 이해와 실제, p.309"]],"pictures":[{"src":"/images/lectures/microdegree1/4-1/pictures/9d19d561f02e12f1.webp","x":0.5236,"y":0.2132,"width":0.4078,"height":0.5883}]},{"title":"색 값과 이미지 용량","text":["출처: 박정호(2025), AI융합교육의 이해와 실제, pp.311~312","RGB 세 값이 각각 8비트이면 한 픽셀에 24비트가 필요하고 약 1,677만 가지 색을 표현합니다.","1920×1080 이미지는 픽셀이 약 207만 개이므로 압축하지 않으면 약 6.2MB입니다.","색 값과 이미지 용량","색","R","G","B","빨강","255","0","0","노랑","255","255","0","흰색","255","255","255","회색","128","128","128","검정","0","0","0"],"links":[],"sourcePage":17,"image":"/images/lectures/microdegree1/4-1/017.webp","lines":[[0.0156,0.032,0.1692,0.0536,"색 값과 이미지 용량"],[0.0955,0.161,0.8135,0.062,"RGB 세 값이 각각 8비트이면 한 픽셀에 24비트가 필요하고 약 1,677만 가지 색을 표현합니다."],[0.1202,0.2231,0.6474,0.0469,"1920×1080 이미지는 픽셀이 약 207만 개이므로 압축하지 않으면 약 6.2MB입니다."],[0.1734,0.4185,0.0169,0.0469,"색"],[0.4083,0.4185,0.0138,0.0469,"R"],[0.6199,0.4185,0.0148,0.0469,"G"],[0.8326,0.4185,0.0138,0.0469,"B"],[0.1651,0.4832,0.0336,0.0469,"빨강"],[0.3972,0.4832,0.036,0.0469,"255"],[0.6213,0.4832,0.012,0.0469,"0"],[0.8335,0.4832,0.012,0.0469,"0"],[0.1651,0.548,0.0336,0.0469,"노랑"],[0.3972,0.548,0.036,0.0469,"255"],[0.6094,0.548,0.036,0.0469,"255"],[0.8335,0.548,0.012,0.0469,"0"],[0.1651,0.6128,0.0336,0.0469,"흰색"],[0.3972,0.6128,0.036,0.0469,"255"],[0.6094,0.6128,0.036,0.0469,"255"],[0.8215,0.6128,0.036,0.0469,"255"],[0.1651,0.6775,0.0336,0.0469,"회색"],[0.3972,0.6775,0.036,0.0469,"128"],[0.6094,0.6775,0.036,0.0469,"128"],[0.8215,0.6775,0.036,0.0469,"128"],[0.1651,0.7423,0.0336,0.0469,"검정"],[0.4092,0.7423,0.012,0.0469,"0"],[0.6213,0.7423,0.012,0.0469,"0"],[0.8335,0.7423,0.012,0.0469,"0"],[0.6489,0.9408,0.3404,0.0335,"출처: 박정호(2025), AI융합교육의 이해와 실제, pp.311~312"]]},{"title":"RGB 값으로 색 만들기","text":["R, G, B 값을 0부터 255까지 바꾸어 빨강, 노랑, 회색 만들기","한 픽셀의 24비트"],"links":[],"kind":"lab","labId":"rgbMix","sourceAfter":17},{"title":"소리의 표본화와 양자화","text":["표본화는 연속된 소리를 일정한 시간 간격으로 재는 과정이고 양자화는 잰 값을 정해진 단계의 수로 바꾸는 과정입니다.","음악 CD는 1초에 44,100번 재고 값마다 16비트를 사용합니다.","소리의 표본화와 양자화","일정 간격으로 값을 뽑는 표본화","3비트와 4비트 양자화"],"links":[],"sourcePage":18,"image":"/images/lectures/microdegree1/4-1/018.webp","lines":[[0.0156,0.032,0.2031,0.0536,"소리의 표본화와 양자화"],[0.0955,0.161,0.8291,0.0536,"표본화는 연속된 소리를 일정한 시간 간격으로 재는 과정이고 양자화는 잰 값을 정해진 단계의 수로"],[0.0955,0.2147,0.1683,0.062,"바꾸는 과정입니다."],[0.1202,0.2767,0.4765,0.0469,"음악 CD는 1초에 44,100번 재고 값마다 16비트를 사용합니다."],[0.6725,0.7404,0.1173,0.0335,"3비트와 4비트 양자화"],[0.1865,0.8102,0.165,0.0335,"일정 간격으로 값을 뽑는 표본화"]],"pictures":[{"src":"/images/lectures/microdegree1/4-1/pictures/2b2f46805074d848.webp","x":0.049,"y":0.4354,"width":0.4399,"height":0.3668},{"src":"/images/lectures/microdegree1/4-1/pictures/fcc351cc3519dfe3.webp","x":0.5112,"y":0.5053,"width":0.4399,"height":0.2271}]},{"title":"텍스트와 토큰","text":["언어 모델은 문장을 토큰이라는 작은 단위로 나누고 토큰마다 번호를 붙여 계산합니다.","토큰은 단어, 단어의 일부, 문장 부호가 될 수 있으며 나누는 방식은 모델마다 다릅니다.","텍스트와 토큰","문장","나는 사과를","좋아해","토큰 나누기","나, 는, 사과,","를, 좋아해","번호 붙이기","토큰마다","사전의 번호","벡터로 바꾸기","번호마다","수의 목록"],"links":[],"sourcePage":19,"image":"/images/lectures/microdegree1/4-1/019.webp","lines":[[0.0156,0.032,0.1209,0.0536,"텍스트와 토큰"],[0.0955,0.161,0.7258,0.062,"언어 모델은 문장을 토큰이라는 작은 단위로 나누고 토큰마다 번호를 붙여 계산합니다."],[0.1202,0.2231,0.6259,0.0469,"토큰은 단어, 단어의 일부, 문장 부호가 될 수 있으며 나누는 방식은 모델마다 다릅니다."],[0.1316,0.5867,0.0435,0.062,"문장"],[0.1107,0.6487,0.0841,0.0492,"나는 사과를"],[0.1279,0.6979,0.046,0.0436,"좋아해"],[0.3329,0.5867,0.1064,0.062,"토큰 나누기"],[0.3416,0.6487,0.0878,0.0492,"나, 는, 사과,"],[0.3486,0.6979,0.0701,0.0436,"를, 좋아해"],[0.5657,0.5867,0.1064,0.062,"번호 붙이기"],[0.5858,0.6487,0.065,0.0492,"토큰마다"],[0.5763,0.6979,0.0803,0.0436,"사전의 번호"],[0.7887,0.5867,0.1257,0.062,"벡터로 바꾸기"],[0.8186,0.6487,0.065,0.0492,"번호마다"],[0.8167,0.6979,0.065,0.0436,"수의 목록"]]},{"title":"AI가 입력을 숫자로 바꾸는 이유","text":["AI 모델은 곱하고 더하는 계산으로 입력을 처리하므로 모든 입력을 숫자의 목록인 특성 벡터로 바꿉니다.","사진은 픽셀 값의 목록, 설문 응답은 문항별 값의 목록이 됩니다.","AI가 입력을 숫자로 바꾸는 이유","입력","사진, 글,","소리, 표","숫자 표현","픽셀 값, 토큰 번호,","측정값","특성 벡터","[0.2, 0.8, 0.1, …]","모델의 결과","클래스별 점수"],"links":[],"sourcePage":20,"image":"/images/lectures/microdegree1/4-1/020.webp","lines":[[0.0156,0.032,0.2749,0.0536,"AI가 입력을 숫자로 바꾸는 이유"],[0.0955,0.161,0.7901,0.0536,"AI 모델은 곱하고 더하는 계산으로 입력을 처리하므로 모든 입력을 숫자의 목록인 특성 벡터로"],[0.0955,0.2147,0.0873,0.062,"바꿉니다."],[0.1202,0.2767,0.4598,0.0469,"사진은 픽셀 값의 목록, 설문 응답은 문항별 값의 목록이 됩니다."],[0.1316,0.5633,0.0435,0.062,"입력"],[0.1209,0.6253,0.0636,0.0492,"사진, 글,"],[0.1235,0.6744,0.0548,0.0436,"소리, 표"],[0.3426,0.5633,0.087,0.062,"숫자 표현"],[0.3193,0.6253,0.1324,0.0492,"픽셀 값, 토큰 번호,"],[0.3607,0.6744,0.046,0.0436,"측정값"],[0.5753,0.5878,0.087,0.062,"특성 벡터"],[0.5469,0.6499,0.1391,0.0436,"[0.2, 0.8, 0.1, …]"],[0.7984,0.5878,0.1064,0.062,"모델의 결과"],[0.8014,0.6499,0.0957,0.0436,"클래스별 점수"]]},{"title":"손글씨 숫자 한 장의 784개 값","text":["손글씨 숫자 데이터셋 MNIST는 한 장을 28×28 픽셀의 밝기 값으로 저장합니다.","한 장은 784개의 숫자이고 모델은 이 숫자들의 패턴과 정답 숫자의 관계를 학습합니다.","사람에게는 모양이지만 모델에게는 숫자의 배열입니다.","손글씨 숫자 한 장의 784개 값","출처: LeCun 외(1998), Gradient-based learning applied to document recognition","28×28 픽셀로 나눈 손글씨 숫자 1"],"links":[],"sourcePage":21,"image":"/images/lectures/microdegree1/4-1/021.webp","lines":[[0.0156,0.032,0.2603,0.0536,"손글씨 숫자 한 장의 784개 값"],[0.1202,0.161,0.3035,0.0469,"손글씨 숫자 데이터셋 MNIST는 한 장을"],[0.1202,0.2079,0.3046,0.0553,"28×28 픽셀의 밝기 값으로 저장합니다."],[0.1202,0.2632,0.3447,0.0469,"한 장은 784개의 숫자이고 모델은 이 숫자들의"],[0.1202,0.3101,0.2897,0.0553,"패턴과 정답 숫자의 관계를 학습합니다."],[0.1202,0.3655,0.3131,0.0469,"사람에게는 모양이지만 모델에게는 숫자의"],[0.1202,0.4124,0.088,0.0469,"배열입니다."],[0.6339,0.6978,0.1871,0.0335,"28×28 픽셀로 나눈 손글씨 숫자 1"],[0.4821,0.9408,0.5072,0.0335,"출처: LeCun 외(1998), Gradient-based learning applied to document recognition"]],"pictures":[{"src":"/images/lectures/microdegree1/4-1/pictures/bff2fd2da649dc99.webp","x":0.5236,"y":0.3248,"width":0.4078,"height":0.3651}]},{"title":"실습 1 픽셀로 그림 주고받기","text":["출처: CS Unplugged, Image Representation","목적은 그림을 0과 1의 규칙으로 기록하고 기록만으로 같은 그림을 복원할 수 있는지 확인하는 것입니다.","짝 활동이며 산출물은 모눈 그림과 기록지, 시간은 15분입니다.","실습 1 픽셀로 그림 주고받기","1 그림 칠하기","8×8 모눈에","간단한 그림","2 기록하기","칠한 칸 1, 빈칸 0","한 줄씩 기록","3 복원하기","기록만 전달,","짝이 빈 모눈에 복원","4 비교하기","원본과 비교해","틀린 칸의 원인 찾기"],"links":[],"sourcePage":22,"image":"/images/lectures/microdegree1/4-1/022.webp","lines":[[0.0156,0.032,0.2463,0.0536,"실습 1 픽셀로 그림 주고받기"],[0.0955,0.161,0.794,0.0536,"목적은 그림을 0과 1의 규칙으로 기록하고 기록만으로 같은 그림을 복원할 수 있는지 확인하는"],[0.0955,0.2147,0.0873,0.062,"것입니다."],[0.1202,0.2767,0.4592,0.0469,"짝 활동이며 산출물은 모눈 그림과 기록지, 시간은 15분입니다."],[0.0906,0.5633,0.1254,0.062,"1 그림 칠하기"],[0.1073,0.6253,0.091,0.0492,"8×8 모눈에"],[0.1107,0.6744,0.0803,0.0436,"간단한 그림"],[0.3354,0.5633,0.1013,0.062,"2 기록하기"],[0.3242,0.6253,0.1226,0.0492,"칠한 칸 1, 빈칸 0"],[0.3416,0.6744,0.0841,0.0436,"한 줄씩 기록"],[0.5682,0.5633,0.1013,0.062,"3 복원하기"],[0.5737,0.6253,0.0892,0.0492,"기록만 전달,"],[0.5495,0.6744,0.1338,0.0436,"짝이 빈 모눈에 복원"],[0.801,0.5633,0.1013,0.062,"4 비교하기"],[0.8014,0.6253,0.0994,0.0492,"원본과 비교해"],[0.7823,0.6744,0.1338,0.0436,"틀린 칸의 원인 찾기"],[0.7149,0.9408,0.2744,0.0335,"출처: CS Unplugged, Image Representation"]]},{"title":"0과 1로 기록한 그림","text":["0과 1로 기록한 그림","한 줄에 여덟 칸이라는 규칙과 1이 칠한 칸이라는 약속을 알아야 기록을 그림으로 복원할 수 있습니다.","칠한 칸은 1, 빈칸은 0으로 기록한 예시"],"links":[],"sourcePage":23,"image":"/images/lectures/microdegree1/4-1/023.webp","lines":[[0.0156,0.032,0.1784,0.0536,"0과 1로 기록한 그림"],[0.0512,0.1564,0.7393,0.0469,"한 줄에 여덟 칸이라는 규칙과 1이 칠한 칸이라는 약속을 알아야 기록을 그림으로 복원할 수 있습니다."],[0.3982,0.883,0.2037,0.0335,"칠한 칸은 1, 빈칸은 0으로 기록한 예시"]],"pictures":[{"src":"/images/lectures/microdegree1/4-1/pictures/5d7cbc0b4e639797.webp","x":0.1933,"y":0.2884,"width":0.6135,"height":0.5867}]},{"title":"기록만 보고 그림 복원하기","text":["0과 1의 기록을 읽고 8×8 모눈에 그림 복원하기","픽셀로 그림 주고받기"],"links":[],"kind":"lab","labId":"pixelRestore","sourceAfter":23},{"title":"해상도와 색 단계 바꿔 보기","text":["8×8을 4×4로 줄이면 기록은 16개로 줄어듭니다.","눈과 입의 경계가 사라져 모양을 알아보기 어렵습니다.","학습 이미지의 해상도도 모델이 볼 수 있는 특징을 정합니다.","해상도와 색 단계 바꿔 보기","칸마다 0부터 3까지 쓰면 네 단계의 밝기를 표현합니다.","한 칸에 2비트가 필요해 기록의 양은 두 배가 됩니다.","세밀함과 저장 용량 사이에서 목적에 맞는 수준을 고릅니다.","픽셀 수 줄이기","색 단계 늘리기"],"links":[],"sourcePage":24,"image":"/images/lectures/microdegree1/4-1/024.webp","lines":[[0.0156,0.032,0.2321,0.0536,"해상도와 색 단계 바꿔 보기"],[0.1861,0.2063,0.1729,0.0738,"픽셀 수 줄이기"],[0.641,0.2063,0.1729,0.0738,"색 단계 늘리기"],[0.0955,0.307,0.3353,0.0536,"8×8을 4×4로 줄이면 기록은 16개로"],[0.0955,0.3606,0.1064,0.062,"줄어듭니다."],[0.1202,0.4226,0.3047,0.0469,"눈과 입의 경계가 사라져 모양을 알아보기"],[0.1202,0.4695,0.092,0.0553,"어렵습니다."],[0.1202,0.5249,0.3087,0.0469,"학습 이미지의 해상도도 모델이 볼 수 있는"],[0.1202,0.5718,0.125,0.0469,"특징을 정합니다."],[0.5504,0.307,0.3656,0.0536,"칸마다 0부터 3까지 쓰면 네 단계의 밝기를"],[0.5504,0.3606,0.1064,0.062,"표현합니다."],[0.5752,0.4226,0.3247,0.0469,"한 칸에 2비트가 필요해 기록의 양은 두 배가"],[0.5752,0.4695,0.059,0.0553,"됩니다."],[0.5752,0.5249,0.3047,0.0469,"세밀함과 저장 용량 사이에서 목적에 맞는"],[0.5752,0.5718,0.125,0.0469,"수준을 고릅니다."]]},{"title":"픽셀 수와 색 단계 실험","text":["8×8과 4×4, 2단계와 4단계로 그림과 기록의 양 비교하기","해상도와 색 단계"],"links":[],"kind":"lab","labId":"pixelDetail","sourceAfter":24},{"title":"03 특성, 레이블과 데이터셋","text":["03","특성, 레이블과 데이터셋"],"links":[],"sourcePage":25,"image":"/images/lectures/microdegree1/4-1/025.webp","lines":[[0.0382,0.2526,0.0632,0.1006,"03"],[0.0382,0.3532,0.3968,0.1207,"특성, 레이블과 데이터셋"]]},{"title":"특성과 레이블","text":["특성은 예측에 쓰는 입력 값이고 레이블은 학습 자료에 붙인 정답입니다.","과일 분류 예시에서 무게, 지름, 색은 특성이고 과일 이름은 레이블입니다.","특성과 레이블","사례","무게(g)","지름(cm)","색","레이블","1","180","7.5","빨강","사과","2","90","6.0","주황","귤","3","200","8.0","초록","사과","4","85","5.5","주황","귤"],"links":[],"sourcePage":26,"image":"/images/lectures/microdegree1/4-1/026.webp","lines":[[0.0156,0.032,0.1209,0.0536,"특성과 레이블"],[0.0955,0.161,0.6076,0.062,"특성은 예측에 쓰는 입력 값이고 레이블은 학습 자료에 붙인 정답입니다."],[0.1202,0.2231,0.5313,0.0469,"과일 분류 예시에서 무게, 지름, 색은 특성이고 과일 이름은 레이블입니다."],[0.1268,0.3179,0.0338,0.0469,"사례"],[0.2904,0.3179,0