로 계속 쌓이므로 측정 간격과"],[0.1202,0.3101,0.1826,0.0553,"단위를 함께 기록합니다."],[0.1202,0.3655,0.2952,0.0469,"교실에서는 온도, 습도, 밝기처럼 개인을"],[0.1202,0.4124,0.2486,0.0469,"알아보기 어려운 값부터 모읍니다."],[0.645,0.8667,0.165,0.0335,"스마트폰에 들어 있는 여러 센서"],[0.6938,0.9408,0.2956,0.0335,"출처: 박정호(2025), AI융합교육의 이해와 실제, p.134"]],"pictures":[{"src":"/images/lectures/microdegree1/4-1/pictures/356cc1d47697ed28.webp","x":0.5298,"y":0.1559,"width":0.3953,"height":0.7028}]},{"title":"02 컴퓨터의 데이터 표현","text":["02","컴퓨터의 데이터 표현"],"links":[],"sourcePage":13,"image":"/images/lectures/microdegree1/4-1/013.webp","lines":[[0.0382,0.2526,0.0632,0.1006,"02"],[0.0382,0.3532,0.348,0.1207,"컴퓨터의 데이터 표현"]]},{"title":"비트와 이진수","text":["컴퓨터는 모든 데이터를 0과 1의 비트로 저장합니다. 비트가 하나 늘 때마다 표현할 수 있는 경우의 수는 두 배가 됩니다.","예를 들어 십진수 13은 8+4+1이므로 8비트로 00001101입니다.","비트와 이진수","비트 수","가능한 조합","경우의 수","1","0, 1","2","2","00, 01, 10, 11","4","3","000부터 111까지","8","8 (1바이트)","00000000부터 11111111까지","256","16 (2바이트)","16자리 조합","65,536"],"links":[],"sourcePage":14,"image":"/images/lectures/microdegree1/4-1/014.webp","lines":[[0.0156,0.032,0.1209,0.0536,"비트와 이진수"],[0.0955,0.161,0.8295,0.0536,"컴퓨터는 모든 데이터를 0과 1의 비트로 저장합니다. 비트가 하나 늘 때마다 표현할 수 있는 경우의"],[0.0955,0.2147,0.1777,0.062,"수는 두 배가 됩니다."],[0.1202,0.2767,0.511,0.0469,"예를 들어 십진수 13은 8+4+1이므로 8비트로 00001101입니다."],[0.1385,0.3716,0.0549,0.0469,"비트 수"],[0.4557,0.3716,0.0887,0.0469,"가능한 조합"],[0.7983,0.3716,0.0718,0.0469,"경우의 수"],[0.1598,0.4363,0.0123,0.0469,"1"],[0.4833,0.4363,0.0335,0.0469,"0, 1"],[0.8282,0.4363,0.012,0.0469,"2"],[0.1598,0.5011,0.0123,0.0469,"2"],[0.4378,0.5011,0.1245,0.0469,"00, 01, 10, 11"],[0.8282,0.5011,0.012,0.0469,"4"],[0.1598,0.5658,0.0123,0.0469,"3"],[0.4291,0.5658,0.1419,0.0469,"000부터 111까지"],[0.8282,0.5658,0.012,0.0469,"8"],[0.118,0.6306,0.096,0.0469,"8 (1바이트)"],[0.3692,0.6306,0.2618,0.0469,"00000000부터 11111111까지"],[0.8162,0.6306,0.036,0.0469,"256"],[0.1118,0.6953,0.1082,0.0469,"16 (2바이트)"],[0.4531,0.6953,0.094,0.0469,"16자리 조합"],[0.8015,0.6953,0.0654,0.0469,"65,536"]]},{"title":"문자