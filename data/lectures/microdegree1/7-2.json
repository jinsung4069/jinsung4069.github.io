3. 짝 검토와 수정"],[0.0955,0.161,0.6385,0.062,"짝의 초안을 읽고 세 질문에 답하며 근거가 되는 부분에 표시합니다. (25분)"],[0.1202,0.223,0.3768,0.0553,"질문 1. 문제 정의와 AI의 역할이 직접 연결되는가?"],[0.1202,0.2783,0.4138,0.0553,"질문 2. AI 결과가 틀렸을 때 누가 어떻게 알아차리는가?"],[0.1202,0.3336,0.4647,0.0553,"질문 3. 학생 입장에서 이 활동이 배울 내용에 집중하게 하는가?"],[0.0955,0.3889,0.6714,0.062,"10분씩 역할을 바꾸어 검토하고 남은 5분 동안 받은 질문을 반영해 수정합니다."],[0.0955,0.451,0.373,0.0536,"산출물은 검토 질문 메모와 수정 기록입니다."]]},{"title":"설계를 마치며 던질 질문","text":["내 활용안에서 AI를 빼면 학생의 배움은 무엇이 달라지는가?","달라지는 것이 없다면 AI의 역할을 다시 정하거나 다른 대안을 선택합니다.","설계를 마치며 던질 질문","활용안 수정","짝 검토 질문을","반영해 고치기","시연 화면","학생이 겪을 장면을","2분 안에 보여 주기","대체 자료","접속 실패에 대비해","화면 캡처나 녹화하기"],"links":[],"sourcePage":47,"image":"/images/lectures/microdegree1/7-2/047.webp","lines":[[0.0156,0.032,0.2079,0.0536,"설계를 마치며 던질 질문"],[0.0955,0.161,0.5111,0.062,"내 활용안에서 AI를 빼면 학생의 배움은 무엇이 달라지는가?"],[0.1202,0.2231,0.5394,0.0469,"달라지는 것이 없다면 AI의 역할을 다시 정하거나 다른 대안을 선택합니다."],[0.1389,0.5331,0.1064,0.062,"활용안 수정"],[0.0568,0.5951,0.1111,0.0525,"짝 검토 질문을"],[0.0568,0.6476,0.103,0.0469,"반영해 고치기"],[0.4589,0.5331,0.087,0.062,"시연 화면"],[0.3671,0.5951,0.1441,0.0525,"학생이 겪을 장면을"],[0.3671,0.6476,0.1396,0.0469,"2분 안에 보여 주기"],[0.7693,0.5331,0.087,0.062,"대체 자료"],[0.6775,0.5951,0.1441,0.0525,"접속 실패에 대비해"],[0.6775,0.6476,0.1566,0.0469,"화면 캡처나 녹화하기"]]}]}
