[0.0156,0.032,0.2273,0.0536,"학교급별 데이터 활동 예시"],[0.0955,0.161,0.6872,0.0536,"학생이 직접 모은 작은 데이터로 질문, 수집, 정리, 해석의 흐름을 경험하게 합니다."],[0.1204,0.3162,0.0507,0.0469,"학교급"],[0.4034,0.3162,0.0718,0.0469,"수업 예시"],[0.7303,0.3162,0.1267,0.0469,"데이터 조건 점검"],[0.1016,0.381,0.0881,0.0469,"초등 저학년"],[0.2424,0.381,0.2717,0.0469,"교실 식물의 키를 매주 재어 표로 정리"],[0.6949,0.381,0.1976,0.0469,"같은 자와 같은 요일에 측정"],[0.1016,0.4692,0.0881,0.0469,"초등 고학년"],[0.2424,0.4692,0.3582,0.0469,"사물 사진으로 분류 모델을 만들고 배경 바꿔 보기"],[0.7051,0.4692,0.1771,0.0469,"얼굴이 없는 사물만 촬영"],[0.1205,0.5574,0.0504,0.0469,"중학교"],[0.2424,0.5574,0.2512,0.0469,"급식 잔반 조사로 요일별 경향 분석"],[0.6949,0.5574,0.1976,0.0469,"잔반 기준과 결측 처리 통일"],[0.1121,0.6457,0.0672,0.0469,"고등학교"],[0.2424,0.6457,0.3502,0.0469,"공공데이터로 지역별 통계를 비교하고 한계 발표"],[0.7051,0.6457,0.1771,0.0469,"기준일과 집계 단위 확인"]]},{"title":"학생 얼굴과 목소리 데이터","text":["출처: 개인정보 보호법 제22조의2, Google, Teachable Machine FAQ","얼굴 사진과 목소리 녹음은 개인을 알아볼 수 있으므로 기본 실습 자료로 쓰지 않습니다.","사물, 그림, 식물 사진으로도 같은 학습 원리를 배울 수 있습니다.","웹캠을 쓸 때는 얼굴, 이름표, 교실 게시물이 화면에 들어오지 않게 구도를 정합니다.","Drive에 저장하거나 모델을 업로드하지 않으면 샘플은 탭을 닫을 때 사라집니다.","만 14세 미만 학생의 개인정보가 필요하면 법정대리인 동의 등 학교의 절차를 먼저 따릅니다.","학생 얼굴과 목소리 데이터"],"links":[],"sourcePage":35,"image":"/images/lectures/microdegree1/4-2/035.webp","lines":[[0.0156,0.032,0.2273,0.0536,"학생 얼굴과 목소리 데이터"],[0.0955,0.161,0.7346,0.062,"얼굴 사진과 목소리 녹음은 개인을 알아볼 수 있으므로 기본 실습 자료로 쓰지 않습니다."],[0.1202,0.223,0.4693,0.0553,"사물, 그림, 식물 사진으로도 같은 학습 원리를 배울 수 있습니다."],[0.0955,0.2783,0.7045,0.062,"웹캠을 쓸 때는 얼굴, 이름표, 교실 게시물이 화면에 들어오지 않게 구도를 정합니다."],[0.0955,0.3403,0.6804,0.062,"Drive에 저장하거나 모델을 업로드하지 않으면 샘플은 탭을 닫을 때 사라집니다."],[0.1202,0.4023,0.6718,0.0469,"만 14세 미만 학생의 개인정보가 필요하면 법정대리인 동의 등 학교의 절차를 먼저 따릅니다."],[0.5958,0.9408,0.3935,0.0335,"출처: 개인정보 보호법 제22조의2, Google, Teachable Machine FAQ"]]},{"title":"실습 자료로 써도 될까","text":["학생 얼굴, 목소리, 이름표, 교실 게시물과 사물, 그림, 식물 사진을 실습 자료로 나누기"],"links":[],"kind":"lab","labId":"safeSort","sourceAfter":35},{"title":"Part 2 성찰 질문","text":["Part 2 성찰 질문","결과를 바꾼 조건","오늘 실습에서 데이터 조건 하나가 결과를 바꾼 장면을 한 문장으로 적습니다.","학생에게 던질 질문","그 장면을 학생에게 보여 준다면 어떤 질문으로 시작할지 정합니다.","먼저 점검할 요소","내 수업의 데이터 활동에서 먼저 점검할 품질 요소 두 가지와 이유를 씁니다."],"links":[],"sourcePage":36,"image":"/images/lectures/microdegree1/4-2/036.webp","lines":[[0.0156,0.032,0.1531,0.0536,"Part 2 성찰 질문"],[0.1172,0.4351,0.1499,0.062,"결과를 바꾼 조건"],[0.0568,0.4971,0.2512,0.0469,"오늘 실습에서 데이터 조건 하나가"],[0.0568,0.5441,0.2347,0.0469,"결과를 바꾼 장면을 한 문장으로"],[0.0568,0.591,0.0715,0.0469,"적습니다."],[0.4178,0.4586,0.1692,0.062,"학생에게 던질 질문"],[0.3671,0.5206,0.2347,0.0469,"그 장면을 학생에게 보여 준다면"],[0.3671,0.5675,0.2486,0.0469,"어떤 질문으로 시작할지 정합니다."],[0.7379,0.4351,0.1499,0.062,"먼저 점검할 요소"],[0.6775,0.4971,0.2347,0.0469,"내 수업의 데이터 활동에서 먼저"],[0.6775,0.5441,0.2552,0.0469,"점검할 품질 요소 두 가지와 이유를"],[0.6775,0.591,0.055,0.0469,"씁니다."]]}]}
