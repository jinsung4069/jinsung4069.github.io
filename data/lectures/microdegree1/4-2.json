,[0.0955,0.3655,0.3459,0.0536,"https://youtu.be/T2qQGqZxkD0"],[0.5575,0.9408,0.4318,0.0335,"영상: Google, Teachable Machine 2.0: Making AI easier for everyone"]]},{"title":"브라우저에서 학습하는 이미지 모델","text":["출처: Google, Teachable Machine FAQ","Teachable Machine은 계정 없이 시작하며 학습은 브라우저 탭 안에서 이루어집니다.","미리 학습된 신경망을 바탕으로 우리가 만든 클래스 부분만 새로 학습하는 전이학습을 씁니다.","Drive에 저장하지 않으면 샘플은 서버로 전송되지 않습니다.","브라우저에서 학습하는 이미지 모델","샘플 모으기","웹캠 또는","파일 업로드","학습","모델 학습시키기","미리보기","새 입력의","클래스별 점수","내보내기","필요할 때만","선택"],"links":[],"sourcePage":24,"image":"/images/lectures/microdegree1/4-2/024.webp","lines":[[0.0156,0.032,0.3047,0.0536,"브라우저에서 학습하는 이미지 모델"],[0.0955,0.161,0.7555,0.062,"Teachable Machine은 계정 없이 시작하며 학습은 브라우저 탭 안에서 이루어집니다."],[0.1202,0.2231,0.6809,0.0553,"미리 학습된 신경망을 바탕으로 우리가 만든 클래스 부분만 새로 학습하는 전이학습을 씁니다."],[0.1202,0.2784,0.4405,0.0469,"Drive에 저장하지 않으면 샘플은 서버로 전송되지 않습니다."],[0.1001,0.6144,0.1064,0.062,"샘플 모으기"],[0.1184,0.6764,0.0688,0.0492,"웹캠 또는"],[0.1107,0.7256,0.0803,0.0436,"파일 업로드"],[0.3643,0.639,0.0435,0.062,"학습"],[0.3282,0.701,0.111,0.0436,"모델 학습시키기"],[0.5777,0.6144,0.0822,0.062,"미리보기"],[0.5839,0.6764,0.0688,0.0492,"새 입력의"],[0.5686,0.7256,0.0957,0.0436,"클래스별 점수"],[0.8105,0.6144,0.0822,0.062,"내보내기"],[0.809,0.6764,0.0841,0.0492,"필요할 때만"],[0.8339,0.7256,0.0306,0.0436,"선택"],[0.7492,0.9408,0.2401,0.0335,"출처: Google, Teachable Machine FAQ"]]},{"title":"실습 화면 구성","text":["출처: Google, Teachable Machine","왼쪽 클래스 카드에 이름을 붙이고 웹캠이나 업로드로 샘플을 넣습니다.","가운데 학습 카드에서 모델 학습시키기를 누릅니다.","오른쪽 미리보기에서 입력을 파일로 바꾸고 평가 사진을 넣어 출력을 확인합니다.","실습 화면 구성","Teachable Machine 이미지 프로젝트 화면"],"links":[],"sourcePage":25,"image":"/images/lectures/microdegree1/4-2/025.webp","lines":[[0.0156,0.032,0.1257,0.0536,"실습 화면 구성"],[0.1202,0.161,0.5203,0.0553,"왼쪽 클래스 카드에 이름을 붙이고 웹캠이나 업로드로 샘플을 넣습니다."],[0.1202,0.2164,0.3762,0.0553,"가운데 학습 카드에서 모델 학습시키기를 누릅니다."],[0.1202,0.2717,0.5863,0.0469,"오른쪽 미리보기에서 입력을 파일로 바꾸고 평가 사진을 넣어 출력을 확인합니다."],[0.3781,0.883,0.2438,0.0335,"Teachable Machine 이미지 프로젝트 화면"],[0.7789,0.9408,0.2104,0.0335,"출처: Google, Teachable Machine"]],"pictures":[{"src":"/images/lectures/microdegree1/4-2/pictures/920d82350a77fff1.webp","x":0.2414,"y":0.3576,"width":0.5174,"height":0.5175}]},{"title":"기준 모델과 네 가지 조건","text":["기준 모델과 네 가지 조건","모든 모둠은 기준 모델과 조건 모델을 하나씩 만들고 조건 모델에서는 한 가지만 바꿉니다.","평가 사진 10장(클래스마다 5장)은 새 배경에서 따로 찍고 학습에는 넣지 않습니다.","모델","풀 클래스","지우개 클래스","바꾼 점","기준","30장, 배경 3종","30장, 배경 3종","없음","조건 1","데이터 양","5장, 배경 3종","5장, 배경 3종","사진 수","조건 2","배경 다양성","30장, 흰 종이만","30장, 어두운 천만","배경과 클래스가 겹침","조건 3","클래스 불균형","30장, 배경 3종","5장, 배경 3종","클래스별 사진 수","조건 4","잘못된 레이블","30장 중 9장은 지우개","30장 중 9장은 풀","레이블 30% 오류"],"links":[],"sourcePage":26,"image":"/images/lectures/microdegree1/4-2/026.webp","lines":[[0.0156,0.032,0.2128,0.0536,"기준 모델과 네 가지 조건"],[0.0512,0.1564,0.6567,0.0469,"모든 모둠은 기준 모델과 조건 모델을 하나씩 만들고 조건 모델에서는 한 가지만 바꿉니다."],[0.0512,0.2033,0.6143,0.0469,"평가 사진 10장(클래스마다 5장)은 새 배경에서 따로 찍고 학습에는 넣지 않습니다."],[0.1369,0.3057,0.0314,0.0436,"모델"],[0.333,0.3057,0.0668,0.0436,"풀 클래스"],[0.5489,0.3057,0.0982,0.0436,"지우개 클래스"],[0.8042,0.3057,0.0511,0.0436,"바꾼 점"],[0.137,0.3671,0.0312,0.0436,"기준"],[0.3128,0.3671,0.1072,0.0436,"30장, 배경 3종"],[0.5445,0.3671,0.1072,0.0436,"30장, 배경 3종"],[0.8144,0.3671,0.0306,0.0436,"없음"],[0.1293,0.4285,0.0503,0.0436,"조건 1"],[0.1194,0.472,0.0663,0.0436,"데이터 양"],[0.3184,0.4503,0.0961,0.0436,"5장, 배경 3종"],[0.55,0.4503,0.0961,0.0436,"5장, 배경 3종"],[0.8049,0.4503,0.0497,0.0436,"사진 수"],[0.1293,0.5335,0.0503,0.0436,"조건 2"],[0.1116,0.577,0.0819,0.0436,"배경 다양성"],[0.3107,0.5552,0.1114,0.0436,"30장, 흰 종이만"],[0.5347,0.5552,0.1267,0.0436,"30장, 어두운 천만"],[0.757,0.5552,0.1454,0.0436,"배경과 클래스가 겹침"],[0.1293,0.6384,0.0503,0.0436,"조건 3"],[0.1038,0.682,0.0975,0.0436,"클래스 불균형"],[0.3128,0.6602,0.1072,0.0436,"30장, 배경 3종"],[0.55,0.6602,0.0961,0.0436,"5장, 배경 3종"],[0.7723,0.6602,0.1147,0.0436,"클래스별 사진 수"],[0.1293,0.7434,0.0503,0.0436,"조건 4"],[0.1038,0.787,0.0975,0.0436,"잘못된 레이블"],[0.2905,0.7652,0.1518,0.0436,"30장 중 9장은 지우개"],[0.5375,0.7652,0.1211,0.0436,"30장 중 9장은 풀"],[0.7678,0.7652,0.1238,0.0436,"레이블 3