5,0.369,0.2668,0.062,"AI가 틀릴 수도 있을 것 같아요."],[0.1202,0.431,0.3102,0.0469,"어느 부분을 어떻게 고칠지 알 수 없습니다."],[0.5504,0.307,0.3232,0.0536,"3단계에서 비교 기준이 표로 제시되어"],[0.5504,0.3606,0.0873,0.062,"좋습니다."],[0.5504,0.4226,0.3332,0.0536,"따로 남긴 사진이 없으면 오류를 어떻게"],[0.5504,0.4763,0.1126,0.062,"확인하나요?"],[0.5752,0.5383,0.3186,0.0469,"부분과 기준을 가리켜 수정으로 이어집니다."]]},{"title":"07 평가와 개선","text":["07","평가와 개선"],"links":[],"sourcePage":18,"image":"/images/lectures/microdegree1/8-1/018.webp","lines":[[0.0382,0.2526,0.0632,0.1006,"07"],[0.0382,0.3532,0.1923,0.1207,"평가와 개선"]]},{"title":"루브릭을 적용하는 방법","text":["기준마다 활용안에서 근거가 되는 문장이나 화면을 먼저 찾고 수준을 정합니다.","발표의 인상이나 도구의 화려함이 다른 기준의 판단에 번지지 않게 합니다.","루브릭을 적용하는 방법","근거 찾기","기준에 해당하는","문장과 화면","기준별 판정","한 기준씩","따로 판단","경계 확인","수준 설명의","핵심 단어 대조","종합과 기록","판정 근거를","한 줄로 기록"],"links":[],"sourcePage":19,"image":"/images/lectures/microdegree1/8-1/019.webp","lines":[[0.0156,0.032,0.2031,0.0536,"루브릭을 적용하는 방법"],[0.0955,0.161,0.6668,0.062,"기준마다 활용안에서 근거가 되는 문장이나 화면을 먼저 찾고 수준을 정합니다."],[0.1202,0.2231,0.5368,0.0469,"발표의 인상이나 도구의 화려함이 다른 기준의 판단에 번지지 않게 합니다."],[0.1098,0.5633,0.087,0.062,"근거 찾기"],[0.0954,0.6253,0.1147,0.0492,"기준에 해당하는"],[0.1107,0.6744,0.0803,0.0436,"문장과 화면"],[0.3329,0.5633,0.1064,0.062,"기준별 판정"],[0.3512,0.6253,0.0688,0.0492,"한 기준씩"],[0.3512,0.6744,0.065,0.0436,"따로 판단"],[0.5753,0.5633,0.087,0.062,"경계 확인"],[0.5763,0.6253,0.0841,0.0492,"수준 설명의"],[0.5667,0.6744,0.0994,0.0436,"핵심 단어 대조"],[0.7984,0.5633,0.1064,0.062,"종합과 기록"],[0.809,0.6253,0.0841,0.0492,"판정 근거를"],[0.8072,0.6744,0.0841,0.0436,"한 줄로 기록"]]},{"title":"자기 평가표","text":["자기 평가표","기준","내 수준","근거가 되는 부분","보완할 점","문제 정의","AI 필요성","원리 이해","결과 검증","윤리와 개인정보","실행 가능성","발표"],"links":[],"sourcePage":20,"image":"/images/lectures/microdegree1/8-1/020.webp","lines":[[0.0156,0.032,0.1016,0.0536,"자기 평가표"],[0.143,0.1633,0.0338,0.0469,"기준"],[0.3025,0.1633,0.0549,0.0469,"내 수준"],[0.4691,0.1633,0.1267,0.0469,"근거가 되는 부분"],[0.7719,0.1633,0.0718,0.0469,"보완할 점"],[0.0601,0.2281,0.0713,0.0469,"문제 정의"],[0.0601,0.2929,0.0746,0